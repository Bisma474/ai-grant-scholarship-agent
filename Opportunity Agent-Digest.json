    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto = require('crypto');\nconst normalized = (\n  $input.item.json.title + $input.item.json.org\n).toLowerCase().replace(/\\s+/g, ' ').trim();\n\nconst hash = crypto.createHash('md5').update(normalized).digest('hex');\n\nreturn {\n  ...$input.item.json,\n  hash: hash\n};"
      },
