      "id": "036f2275-dadb-44c7-8a36-190fb01e8e88",
      "name": "Check Eligibility",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2464,
        192
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "groqApi": {
          "id": "xZXMFS8UbOYRtOXb",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const responseText = $input.item.json.choices[0].message.content;\nconst cleaned = responseText.replace(/```json|```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { eligible: false, reason: 'parse_error', missing_requirements: [] };\n}\n\n// Extract deadline from description\nconst description = $('Build Eligibility Body').item.json.description || '';\nlet deadline = '';\n\nconst patterns = [\n  /Deadline:\\s*([A-Za-z]+\\s+\\d{1,2},?\\s+\\d{4})/i,\n  /Deadline:\\s*(\\d{1,2}\\s+[A-Za-z]+,?\\s+\\d{4})/i,\n  /Application Deadline:\\s*([A-Za-z]+\\s+\\d{1,2},?\\s+\\d{4})/i,\n  /Application Deadline:\\s*(\\d{1,2}\\s+[A-Za-z]+,?\\s+\\d{4})/i,\n  /Deadline:\\s*(On Rolling Basis)/i,\n  /Deadline:\\s*(Ongoing)/i,\n];\n\nfor (const pattern of patterns) {\n  const match = description.match(pattern);\n  if (match) {\n    deadline = match[1].trim();\n    break;\n  }\n}\n\nreturn {\n  ...$('Build Eligibility Body').item.json,\n  eligible: parsed.eligible,\n  eligibilityReason: parsed.reason,\n  missingRequirements: (parsed.missing_requirements || []).join(', '),\n  deadline: deadline\n};"
      },
