      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const profile = $('Get Profile').first().json;\nconst opp = $input.item.json;\n\nconst prompt = `You are an eligibility checker. Given the student profile and opportunity below, determine eligibility. Respond ONLY with valid JSON, no markdown, no preamble, no explanation outside the JSON.\n\nSTUDENT PROFILE:\nField: ${profile.field}\nDegree Level: ${profile['degree-level']}\nCGPA: ${profile.cgpa}\nCountry: ${profile.country}\nSkills: ${profile.skill}\n\nOPPORTUNITY:\nTitle: ${opp.title}\nOrg: ${opp.org}\nDescription: ${opp.description}\n\nRespond in this exact JSON shape and nothing else:\n{\"eligible\": true, \"reason\": \"one sentence\", \"missing_requirements\": []}`;\n\nreturn {\n  ...opp,\n  requestBody: JSON.stringify({\n    model: \"openai/gpt-oss-20b\",\n    messages: [\n      { role: \"user\", content: prompt }\n    ]\n  })\n};"
      },
      "id": "e49bfa8d-383b-46a3-9d30-b78483434240",
      "name": "Build Eligibility Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        192
      ]
